@model CentralChamados.Models.Chamado

@{
    ViewData["Title"] = "Excluir Chamado";
}

<div class="container mt-4">

    <h2 class="mb-4">Excluir Chamado #@Model.Id</h2>

    <div class="alert alert-danger">
        Tem certeza de que deseja excluir este chamado? Esta ação não pode ser desfeita.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h4>@Model.Titulo</h4>
            <hr />
            <p><strong>Descrição:</strong> @Model.Descricao</p>
            <p><strong>Solicitante:</strong> @Model.Solicitante</p>
            <p><strong>Prioridade:</strong> @Model.Prioridade</p>
            <p><strong>Status:</strong> @Model.Status</p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Excluir</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
            </form>

        </div>
    </div>
</div>
